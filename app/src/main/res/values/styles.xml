<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tipografia: quando adicionar a Inter, troque só o fontFamily aqui -->
    <style name="TextAppearance.FinControl.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/colorText</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="TextAppearance.FinControl.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorText</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.FinControl.Label" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TextAppearance.FinControl.Value" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Cartão -->
    <style name="Widget.FinControl.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/colorCard</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Chip pílula -->
    <style name="ShapeAppearanceOverlay.FinControl.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="Widget.FinControl.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="checkedIconTint">@color/primaryColor</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.FinControl.Pill</item>
    </style>

    <!-- Campo de texto -->
    <style name="Widget.FinControl.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/primaryColor</item>
        <item name="hintTextColor">@color/primaryDarkColor</item>
    </style>

    <!-- Botão primário (pressed = #047857) -->
    <style name="Widget.FinControl.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_bg_selector</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">16dp</item>
    </style>
</resources>