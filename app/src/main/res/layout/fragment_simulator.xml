<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="112dp">

        <TextView
            style="@style/TextAppearance.FinControl.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Simulador" />

        <!-- Alerta (mostre via Kotlin: visibility = VISIBLE) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_simulator_alert"
            style="@style/Widget.FinControl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/colorWarning"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_simulator_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:padding="16dp"
                android:textColor="@color/colorOnPrimary"
                android:textSize="14sp"
                tools:text="Atenção: nesse ritmo você estoura o orçamento em março." />
        </com.google.android.material.card.MaterialCardView>

        <!-- Gráfico empilhado -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FinControl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/spending_chart"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:padding="16dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.FinControl.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Detalhamento por mês" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_monthly_breakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>