<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/colorOutline" />

    <TextView
        style="@style/TextAppearance.FinControl.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Registrar gasto rápido" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.FinControl.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Valor (R$)"
        app:prefixText="R$ ">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/expense_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.FinControl.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:hint="Descrição">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/expense_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/TextAppearance.FinControl.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Categoria" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            style="@style/Widget.FinControl.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Fixo" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.FinControl.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lazer" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.FinControl.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alimentação" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.FinControl.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transporte" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.FinControl.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Moradia" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        style="@style/TextAppearance.FinControl.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Parcelas" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_installments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                style="@style/Widget.FinControl.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="1x" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.FinControl.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2x" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.FinControl.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3x" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.FinControl.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6x" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.FinControl.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10x" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.FinControl.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12x" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_expense"
        style="@style/Widget.FinControl.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Salvar lançamento" />
</LinearLayout>